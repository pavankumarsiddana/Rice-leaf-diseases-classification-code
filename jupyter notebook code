    class_names: List[str] = field(default_factory=lambda: [
        "Bacterial Leaf Blight",
        "Brown Spot",
        "Healthy Rice Leaf",
        "Leaf Blast",
        "Leaf scald",
        "Narrow Brown Leaf Spot",
        "Rice Hispa",
